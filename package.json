{
  "name": "kyminfo-codelab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && vite --host 127.0.0.1 --port 5185 --strictPort",
    "build": "node scripts/generate.mjs && tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4185 --strictPort",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "jsbarcode": "3.12.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/qrcode": "1.5.6",
    "@zxing/library": "0.23.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
